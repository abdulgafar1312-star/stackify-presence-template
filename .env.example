# Stackify Presence template - environment template
# Configure these in the Netlify site UI (Site configuration -> Environment variables).
# Never commit real values.

# Stackify Website ID, e.g. STK-WEB-00001
STACKIFY_WEBSITE_ID=

# Full URL of the entitlement endpoint
# e.g. https://app.stackify.example/api/method/stackify_os.api.entitlement.get
STACKIFY_ENTITLEMENT_ENDPOINT=

# Per-site credential issued by Stackify OS
STACKIFY_SITE_SECRET=

# production | staging | development
STACKIFY_ENVIRONMENT=production
